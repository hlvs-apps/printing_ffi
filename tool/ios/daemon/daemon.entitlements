<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The daemon runs unsandboxed so it can fork cupsd and the filter pipeline.
     It does NOT open USB itself (the Gutenprint backend does, with its own
     iokit-user-client entitlements in helper.entitlements), so it needs no USB
     entitlement here. Honored only on a jailbroken device. -->
<plist version="1.0"><dict>
<key>platform-application</key><true/>
<key>com.apple.private.security.no-container</key><true/>
<key>com.apple.private.security.no-sandbox</key><true/>
</dict></plist>
